{
  "expo": {
    "name": "Academia_Cotopaxi",
    "slug": "Academia_Cotopaxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AC.png",
    "scheme": "academiacotopaxi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AC.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Academia_Cotopaxi",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6F4FE",
          "image": "./assets/images/AC.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/AC.png",
          "color": "#E6F4FE",
          "defaultChannel": "pomodoro-alarm"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c27b92e-37eb-4199-a61e-45172e28ffca"
      }
    }
  }
}